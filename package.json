{
  "name": "can-i-ignore-it",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "content:baseline": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/content-quality/cli.ts baseline",
    "content:quality": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/content-quality/cli.ts check",
    "content:quality:all": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/content-quality/cli.ts check-all",
    "content:quality:fix": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/content-quality/cli.ts fix",
    "content:quality:deterministic": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/content-quality/cli.ts deterministic",
    "content:import": "tsx scripts/content-import/cli.ts",
    "content:import:check": "tsx scripts/content-import/cli.ts --dry-run",
    "content:prompt": "tsx scripts/content-import/write-prompt.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@next/third-parties": "^16.3.3",
    "@vercel/analytics": "^2.0.1",
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.3",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/node": "^26.3.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
