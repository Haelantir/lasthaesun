# --- Database -------------------------------------------------------------
# Any PostgreSQL connection string. Local development via Docker:
#   docker run -d --name ciii-pg -e POSTGRES_PASSWORD=postgres \
#     -e POSTGRES_USER=postgres -e POSTGRES_DB=canignoreit -p 5433:5432 postgres:16-alpine
DATABASE_URL=postgres://postgres:postgres@localhost:5433/canignoreit

# Set to "require" for hosted providers (Neon, Vercel Postgres, Supabase, RDS).
DATABASE_SSL=disable

# --- Site -----------------------------------------------------------------
# Absolute origin used to build canonical URLs, sitemap entries and JSON-LD.
# No trailing slash. Change this once the production domain is live.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Analytics (optional) -------------------------------------------------
# Left empty, all analytics hooks compile to no-ops and nothing is loaded.
NEXT_PUBLIC_ANALYTICS_ENDPOINT=

# --- Content quality gate (scripts/content-quality) -----------------------
# Anthropic API key for the Claude editorial judge, rewriter and fact-check.
# Never commit a real key: .env.local is gitignored, .env.example holds names only.
ANTHROPIC_API_KEY=

# Model per stage. Any current Claude model id; leave blank to use the default.
CONTENT_JUDGE_MODEL=
CONTENT_REWRITE_MODEL=
CONTENT_FACT_CHECK_MODEL=

# Optional overrides: effort per stage (low|medium|high|xhigh|max), score gates,
# and the rewrite cycle limit.
CONTENT_JUDGE_EFFORT=
CONTENT_MIN_USEFULNESS=
CONTENT_MIN_NATURALNESS=
CONTENT_MIN_LENGTH=
CONTENT_MAX_REWRITE_CYCLES=

# Batch content generation (scripts/content-batch)
# The model that writes the content. No default and no fallback on purpose —
# the wrong model silently changes what the whole site publishes.
OPENAI_API_KEY=
CONTENT_WRITER_MODEL=
CONTENT_WRITER_EFFORT=high
# Set to `off` only to debug. The authoring prompt orders a web search, and
# without one the model invents the source URLs the importer then rejects.
CONTENT_WRITER_WEB_SEARCH=on
CONTENT_WRITER_TIMEOUT_MS=900000

# Target for `npm run warm`, which walks every URL after a deploy so Googlebot
# never pays the cold ISR render. Must be the deployed origin — the warmer
# refuses to run against localhost. NEXT_PUBLIC_SITE_URL above stays localhost
# for `next dev`, which is why this is a separate variable.
WARM_ORIGIN=https://caniignoreit.com
