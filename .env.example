# OpenAI API key. Server-side only — never exposed to the browser.
OPENAI_API_KEY=

# Internal model tiers. "Router" classifies each question; "Nano" answers easy,
# low-risk questions cheaply; "Luna" answers everything else (harder, higher-stakes,
# ambiguous, or needing more context). Point these at whatever OpenAI model IDs you
# want to use for each tier — swap them here without touching any other code.
OPENAI_ROUTER_MODEL=gpt-5-nano
OPENAI_NANO_MODEL=gpt-5-nano
OPENAI_LUNA_MODEL=gpt-5.6-luna

# Used instead of Luna when the Router flags a question as needing live/current
# info (weather, prices, news, etc). This model performs its own web search.
OPENAI_SEARCH_MODEL=gpt-5-search-api

# Speech-to-text model for the "말해서 물어보기" voice input button.
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe

# Port the Express API server listens on. The Vite dev server proxies /api to this.
BACKEND_PORT=8787
